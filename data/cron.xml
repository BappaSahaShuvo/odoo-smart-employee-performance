<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="ir_cron_recalculate_kpis" model="ir.cron">
        <field name="name">KPI Recalculation Engine</field>
        <field name="model_id" ref="model_employee_kpi"/>
        <field name="state">code</field>
        <field name="code">model.search([('state', '=', 'draft')])._compute_kpi_score()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
    </record>
</odoo>