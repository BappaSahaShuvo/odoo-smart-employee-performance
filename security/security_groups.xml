<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="group_performance_employee" model="res.groups">
        <field name="name">Employee</field>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_performance_team_leader" model="res.groups">
        <field name="name">Team Leader</field>
        <field name="implied_ids" eval="[(4, ref('group_performance_employee'))]"/>
    </record>

    <record id="group_performance_manager" model="res.groups">
        <field name="name">Department Manager</field>
        <field name="implied_ids" eval="[(4, ref('group_performance_team_leader'))]"/>
    </record>

    <record id="group_performance_hr" model="res.groups">
        <field name="name">Human Resources (HR)</field>
        <field name="implied_ids" eval="[(4, ref('group_performance_manager'))]"/>
    </record>

    <record id="group_performance_ceo" model="res.groups">
        <field name="name">Chief Executive Officer (CEO)</field>
        <field name="implied_ids" eval="[(4, ref('group_performance_manager'))]"/>
    </record>

    <record id="group_performance_admin" model="res.groups">
        <field name="name">System Administrator</field>
        <field name="implied_ids" eval="[(4, ref('group_performance_ceo')), (4, ref('group_performance_hr')), (4, ref('base.group_system'))]"/>
    </record>
</odoo>