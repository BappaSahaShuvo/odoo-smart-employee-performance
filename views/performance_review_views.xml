<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_perf_review_tree" model="ir.ui.view">
        <field name="name">performance.review.list</field>
        <field name="model">performance.review</field>
        <field name="arch" type="xml">
            <list string="Reviews">
                <field name="employee_id"/>
                <field name="review_period"/>
                <field name="overall_score"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>
</odoo>