<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <menuitem id="menu_performance_root"
              name="Smart Performance"
              sequence="10"/>

    <record id="action_open_performance_dashboard" model="ir.actions.client">
        <field name="name">Performance Dashboard</field>
        <field name="tag">action_open_performance_dashboard</field>
    </record>

    <menuitem id="menu_performance_dashboard"
              name="Enterprise Dashboards"
              parent="menu_performance_root"
              action="action_open_performance_dashboard"
              sequence="1"/>

    <menuitem id="menu_performance_operations"
              name="Operations &amp; Staff"
              parent="menu_performance_root"
              groups="group_performance_team_leader,group_performance_manager,group_performance_hr,group_performance_ceo,group_performance_admin"
              sequence="10"/>

    <menuitem id="menu_op_employees"
              name="Employees Directory"
              parent="menu_performance_operations"
              action="hr.open_view_employee_list_my"
              groups="group_performance_team_leader,group_performance_manager,group_performance_hr,group_performance_ceo,group_performance_admin"
              sequence="1"/>

    <record id="action_employee_attendance_log_view" model="ir.actions.act_window">
        <field name="name">Attendance Logs</field>
        <field name="res_model">employee.attendance.log</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_op_attendance_log"
              name="Log Attendees"
              parent="menu_performance_operations"
              action="action_employee_attendance_log_view"
              groups="group_performance_team_leader,group_performance_manager,group_performance_hr,group_performance_ceo,group_performance_admin"
              sequence="2"/>

    <menuitem id="menu_op_promotions"
              name="Promotion Requests"
              parent="menu_performance_operations"
              action="action_promotion_request"
              groups="group_performance_team_leader,group_performance_manager,group_performance_hr,group_performance_ceo,group_performance_admin"
              sequence="3"/>

    <menuitem id="menu_op_departments"
              name="Departments"
              parent="menu_performance_operations"
              action="hr.hr_department_kanban_action"
              groups="group_performance_team_leader,group_performance_manager,group_performance_hr,group_performance_ceo,group_performance_admin"
              sequence="4"/>
</odoo>